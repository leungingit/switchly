{
  "id": "com.switchly.music-controls",
  "name": {
    "en": "Music Controls",
    "zh-Hans": "音乐控制"
  },
  "version": "1.0.0",
  "apiVersion": 1,
  "summary": {
    "en": "Playback, Love and click-wheel controls for Apple Music.",
    "zh-Hans": "Apple Music 的播放、喜欢与点按转盘控件。"
  },
  "matches": [
    "com.apple.Music"
  ],
  "permissions": [
    "media.nowPlaying",
    "media.control"
  ],
  "entry": "main.js",
  "refreshInterval": 1,
  "settings": [
    {
      "key": "hidePreviews",
      "effect": "hideWindowPreviews",
      "title": {
        "en": "Hide window previews, show only the widget",
        "zh-Hans": "不显示窗口预览，只显示组件"
      },
      "default": false
    },
    {
      "key": "wheelLayout",
      "title": {
        "en": "Click-wheel layout",
        "zh-Hans": "点按转盘布局"
      },
      "default": false
    },
    {
      "key": "showCover",
      "title": {
        "en": "Show album cover",
        "zh-Hans": "显示专辑封面"
      },
      "default": true
    },
    {
      "key": "showLove",
      "title": {
        "en": "Show Love button",
        "zh-Hans": "显示喜欢按钮"
      },
      "default": true
    }
  ]
}
