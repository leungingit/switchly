{
  "schemaVersion": "1.0.0",
  "apiVersions": {
    "supported": [
      1,
      2
    ],
    "recommended": 2,
    "runtimeGate": "1...2",
    "note": "宿主当前只校验 apiVersion 是否位于 1...2；较新的 UI、Scene 与设置类型按 v2 约定发布，但运行时没有逐项按版本拒绝。"
  },
  "packageLimits": {
    "maxPackageBytes": 33554432,
    "maxEntries": 1024,
    "maxManifestBytes": 262144,
    "maxEntryBytes": 2097152,
    "symlinksAllowed": false,
    "manifestVersionRule": "non-empty-string; semver is not required"
  },
  "installPolicy": {
    "firstPhaseSource": "user-selected-local-directory",
    "builtinIDCanBeShadowed": false,
    "sameIDUserUpdate": "replace-after-validation",
    "userUpdateRequiresReauthorization": true
  },
  "features": [
    {
      "id": "runtime.definePlugin",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": "globalThis.__switchlyPlugin",
      "injected": true,
      "description": "入口脚本必须把 render/onAction 对象注册到该全局变量。"
    },
    {
      "id": "runtime.console",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": "console",
      "injected": true,
      "methods": [
        "log",
        "info",
        "debug",
        "warn",
        "error"
      ],
      "limits": {
        "maxLogLength": 500
      }
    },
    {
      "id": "runtime.timers",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": [
        "setTimeout",
        "clearTimeout"
      ],
      "injected": true,
      "limits": {
        "maxPendingTimers": 32
      }
    },
    {
      "id": "runtime.invoke",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "methods": [
        "prepare",
        "render",
        "onAction"
      ],
      "preparation": {
        "optional": true,
        "parallelWithMediaRead": true,
        "contextFields": [
          "app",
          "window",
          "locale",
          "settings",
          "reduceMotion",
          "uiFeatures",
          "t"
        ],
        "actionsEnabled": false,
        "lateResultAfterRender": "discard"
      },
      "supports": [
        "sync",
        "promise",
        "throw"
      ],
      "timeout": {
        "productionMilliseconds": 1000,
        "defaultRuntimeMilliseconds": 200,
        "hardInterrupt": false,
        "consecutiveTimeoutsBeforeDisable": 3
      }
    },
    {
      "id": "ctx.app",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": "ctx.app",
      "injected": true,
      "fields": [
        "bundleID",
        "pid",
        "name",
        "lastActiveAt"
      ]
    },
    {
      "id": "ctx.window",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": "ctx.window",
      "injected": true,
      "fields": [
        "windowID",
        "title"
      ],
      "limits": {
        "titleSummaryCharacters": 40
      }
    },
    {
      "id": "ctx.localization",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": [
        "ctx.locale",
        "ctx.t"
      ],
      "injected": true,
      "localeFiles": "locales/<language>.json",
      "fallback": [
        "preferred language",
        "en",
        "key"
      ]
    },
    {
      "id": "ctx.settings",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": "ctx.settings",
      "injected": true,
      "valueTypes": [
        "boolean",
        "string",
        "number"
      ]
    },
    {
      "id": "ctx.storage",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": "ctx.storage",
      "injected": true,
      "methods": [
        "get",
        "set",
        "remove",
        "clear"
      ],
      "asynchronous": true,
      "returns": "Promise",
      "valueFormat": "JSON",
      "limits": {
        "maxKeyBytes": 256,
        "maxValueBytes": 65536,
        "maxTotalBytes": 1048576
      }
    },
    {
      "id": "ctx.reduceMotion",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": "ctx.reduceMotion",
      "injected": true
    },
    {
      "id": "ctx.invalidate",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": "ctx.invalidate",
      "injected": true
    },
    {
      "id": "ctx.weather.current",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": "ctx.weather.current",
      "injected": "always",
      "permission": "weather.current",
      "withoutPermission": null,
      "networkFromPlugin": false,
      "description": "同步读取宿主已有快照；权限未授权、在线天气关闭、未配置、请求失败或结果过期时均返回 null。"
    },
    {
      "id": "ctx.media.nowPlaying",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": "ctx.media.nowPlaying",
      "injected": "when-authorized",
      "permission": "media.nowPlaying",
      "returns": "Promise<NowPlaying|null>"
    },
    {
      "id": "ctx.media.controls",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": [
        "ctx.media.togglePlayPause",
        "ctx.media.next",
        "ctx.media.previous",
        "ctx.media.setLiked"
      ],
      "injected": "when-authorized",
      "permission": "media.control",
      "returns": "Promise<void>"
    },
    {
      "id": "ctx.media.library",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": "ctx.media.library",
      "injected": "when-authorized",
      "permission": "media.library",
      "methods": [
        "pickRandom",
        "play",
        "pause"
      ]
    },
    {
      "id": "ctx.fs",
      "status": "stable",
      "apiVersions": [
        2
      ],
      "surface": "ctx.fs",
      "injected": "when-authorized",
      "permission": "fs.read",
      "methods": [
        "list",
        "stat",
        "readText",
        "scan",
        "isLocked"
      ],
      "limits": {
        "maxReadBytes": 262144,
        "maxListEntries": 500,
        "maxCallsPerInvocation": 50,
        "maxScanResults": 200,
        "maxScanVisited": 5000,
        "maxScanDepth": 3
      }
    },
    {
      "id": "ui.declarative",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": "render() return value",
      "nodeTypes": [
        "hstack",
        "vstack",
        "zstack",
        "spacer",
        "surface",
        "button",
        "toggle",
        "slider",
        "text",
        "progress",
        "image",
        "badge",
        "marquee",
        "screen",
        "wheel",
        "scene"
      ],
      "limits": {
        "maxDepth": 8,
        "maxNodes": 64,
        "uniqueSlots": true,
        "uniqueActionIds": true
      },
      "buttonVariants": [
        "plain",
        "prominent",
        "labeled"
      ]
    },
    {
      "id": "ui.image.artwork",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": "image.source.artwork",
      "permission": "media.nowPlaying",
      "description": "封面字节由宿主读取和绘制，不传入插件 JS。"
    },
    {
      "id": "ui.image.pluginAsset",
      "status": "stable",
      "apiVersions": [
        2
      ],
      "surface": "image.source.pluginAsset",
      "decoded": true,
      "rendered": true,
      "integrationStatus": "verified-native-rendering",
      "description": "普通插件图片复用 SceneAssets，含路径与解码前纹理预算，已通过原生渲染回归。"
    },
    {
      "id": "scene",
      "status": "stable",
      "apiVersions": [
        2
      ],
      "surface": "ui.scene",
      "layerKinds": [
        "group",
        "rect",
        "ellipse",
        "text",
        "symbol",
        "wave",
        "emitter",
        "sprite",
        "image"
      ],
      "limits": {
        "maxLayers": 160,
        "maxDepth": 6,
        "maxParticles": 400,
        "maxParticlesPerEmitter": 120,
        "maxKeysPerTrack": 160,
        "maxPlucks": 8,
        "maxHits": 12,
        "minDimension": 16,
        "maxDimension": 1200
      }
    },
    {
      "id": "ui.scene3d",
      "status": "unimplemented",
      "contractStatus": "frozen",
      "frozenAt": "2026-11-06",
      "decision": "D26",
      "apiVersions": [
        2
      ],
      "surface": "ui.scene3d",
      "requires": {
        "apiVersion": 2,
        "context": "ctx.uiFeatures.scene3d === true"
      },
      "placement": {
        "slotRootOnly": true,
        "maxPerSlot": 1,
        "nesting": "forbidden",
        "fallbackMustNotContainScene3d": true
      },
      "asset": {
        "format": "self-contained-glTF-2.0-binary",
        "extension": ".glb",
        "maxBytes": 8388608,
        "packageRelative": true,
        "externalURI": false,
        "absolutePath": false,
        "parentTraversal": false,
        "extensionsAllowed": [
          "KHR_materials_clearcoat",
          "KHR_materials_emissive_strength",
          "KHR_materials_unlit"
        ],
        "preflight": "GLBPreflight before any third-party loader"
      },
      "fit": [
        "contain"
      ],
      "camera": {
        "unit": "degrees",
        "yawRange": [
          -180,
          180
        ],
        "pitchRange": [
          -89,
          89
        ],
        "default": {
          "yaw": 0,
          "pitch": 0
        },
        "hostControlled": [
          "distance",
          "fov",
          "clipping",
          "lighting",
          "environment",
          "antialiasing",
          "colorSpace"
        ]
      },
      "rotate": {
        "defaults": {
          "horizontal": true,
          "vertical": true,
          "pitchMin": -55,
          "pitchMax": 55
        },
        "pitchRange": [
          -89,
          89
        ],
        "finiteNumbers": true,
        "reduceMotion": "keep-direct-drag; disable-inertia-and-auto-return"
      },
      "surfaces": {
        "maxPerScene": 5,
        "node": "glTF node.name; exists, unique, resolves to a single visible mesh, complete TEXCOORD_0, not shared with a hit",
        "size": {
          "unit": "output-texture-pixels",
          "integerPerAxis": true,
          "min": 1,
          "max": 1024
        },
        "contentNodeTypes": [
          "hstack",
          "vstack",
          "zstack",
          "spacer",
          "text",
          "progress",
          "image",
          "badge",
          "marquee"
        ],
        "forbiddenContentNodeTypes": [
          "button",
          "toggle",
          "slider",
          "wheel",
          "screen",
          "surface",
          "scene",
          "scene3d",
          "lineChart",
          "timeline"
        ],
        "origin": "top-left",
        "pixelFormat": "RGBA",
        "maxBytesPerInstance": 4194304,
        "update": "only-on-content-change"
      },
      "hits": {
        "maxPerScene": 12,
        "required": [
          "node",
          "id",
          "label"
        ],
        "node": "same rules as surfaces.node; may also be a surface (a textured button)",
        "id": "non-empty and unique within scene3d; may reuse an id from its own fallback subtree",
        "label": "non-empty accessible label",
        "value": {
          "types": [
            "number",
            "null"
          ],
          "default": null
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "sector": {
          "values": [
            "top",
            "right",
            "bottom",
            "left"
          ],
          "optional": true,
          "rule": "several hits may share one node only when each names a distinct sector; sector is a quarter of the node's X/Y plane around the centre of its bounds, split on the diagonals"
        },
        "visibility": "front-facing visible mesh only; drag inside click threshold does not dispatch"
      },
      "fallback": {
        "required": true,
        "nodeTypes": "restricted 2d node",
        "mayContainScene3d": false,
        "visibleWith3d": false,
        "accountedInUiBudget": true,
        "minReadableSlot": {
          "width": 220,
          "height": 380,
          "unit": "pt",
          "measured": "actual-content-size",
          "status": "frozen-candidate; real dock size unverified"
        }
      },
      "naming": {
        "source": "glTF node.name",
        "meshNameLookup": false,
        "caseSensitive": true,
        "fuzzyOrSubstring": false
      },
      "limits": {
        "glbBytes": 8388608,
        "packageBytes": 33554432,
        "meshes": 128,
        "triangles": 150000,
        "nodes": 256,
        "textureEdge": 2048,
        "decodedStaticTextureBytesPerPlugin": 33554432,
        "dynamicSurfaces": 5,
        "dynamicSurfaceEdge": 1024,
        "dynamicSurfaceBytesPerInstance": 4194304,
        "surfaces": 5,
        "hits": 12,
        "uiNodes": 64,
        "uiDepth": 8
      },
      "degradation": {
        "declarationError": "reject-entire-render-output",
        "runtimeError": "fallback-current-node-only",
        "errorCodes": [
          "scene3d.assetMissing",
          "scene3d.preflightRejected",
          "scene3d.decodeFailed",
          "scene3d.nodeNotFound",
          "scene3d.nodeAmbiguous",
          "scene3d.uvMissing",
          "scene3d.renderFailed",
          "scene3d.slotTooSmall"
        ]
      },
      "distribution": {
        "model": "two-release-lines-per-plugin-id",
        "v1Line": "apiVersion 1 for legacy hosts",
        "v2Line": "apiVersion 2 for scene3d-capable hosts",
        "hostLockFile": "exactly one line per host release",
        "newHostLoads": "v2 only",
        "legacyHostLoads": "v1 only"
      },
      "description": "合同已冻结，宿主 T04–T07 未实现。仅 v2 且 ctx.uiFeatures.scene3d 为 true 时可用；apiVersion 2 本身不代表可渲染 3D。"
    },
    {
      "id": "window.focus",
      "status": "unimplemented",
      "apiVersions": [],
      "permission": "window.focus",
      "manifestAccepted": true,
      "injected": false,
      "description": "权限字符串可声明，但当前没有对应 ctx 方法，宿主不会注入聚焦能力。"
    },
    {
      "id": "appleScript",
      "status": "unimplemented",
      "apiVersions": [],
      "permissionPattern": "^appleScript:.+$",
      "manifestAccepted": true,
      "injected": false,
      "description": "权限字符串可声明，但当前没有对应 ctx 方法，宿主不会向插件暴露任意 AppleScript。"
    },
    {
      "id": "ctx.app.activate",
      "status": "unimplemented",
      "apiVersions": [],
      "injected": false
    },
    {
      "id": "ctx.uiFeatures",
      "status": "stable",
      "contractStatus": "frozen",
      "frozenAt": "2026-11-06",
      "decision": "D26",
      "apiVersions": [
        2
      ],
      "surface": "ctx.uiFeatures",
      "injected": true,
      "fields": [
        "scene3d",
        "panel",
        "activity",
        "lineChart",
        "lineChartSeries",
        "timeline"
      ],
      "shape": {
        "scene3d": "boolean",
        "panel": "boolean",
        "activity": "boolean",
        "lineChart": "boolean",
        "timeline": "boolean",
        "lineChartSeries": "boolean"
      },
      "negotiation": {
        "scene3dAvailableWhen": "apiVersion === 2 && ctx.uiFeatures.scene3d === true",
        "missingMeans": "no-negotiation; plugin must return the 2d tree",
        "separateFrom": "ctx.capabilities",
        "lineChartAvailableWhen": "ctx.uiFeatures.lineChart === true",
        "timelineAvailableWhen": "ctx.uiFeatures.timeline === true",
        "lineChartSeriesAvailableWhen": "ctx.uiFeatures.lineChartSeries === true"
      },
      "description": "宿主 UI 特性协商快照，与用户权限表分离。lineChart缺失或为false时回退已有2D节点，不另设ctx.ui协商入口。"
    },
    {
      "id": "ctx.capabilities",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": "ctx.capabilities",
      "description": "按能力名查询 supported/granted/available；window.focus 与 appleScript 始终报告未实现，storage 是基础能力。"
    },
    {
      "id": "ctx.capture.window",
      "status": "stable",
      "apiVersions": [
        2
      ],
      "surface": "ctx.capture.window",
      "injected": "when-authorized",
      "permission": "window.capture",
      "returns": "Promise<accepted|failed>",
      "description": "仅真实onAction有效期间单次提交，绑定宿主窗口目标；不接收windowID、不返回像素/路径，accepted不是输出完成。Preview/Worker纯模拟。"
    },
    {
      "id": "manifest.renderScope",
      "status": "stable",
      "apiVersions": [
        2
      ],
      "values": [
        "app",
        "window"
      ],
      "default": "app",
      "description": "window按卡片渲染，应用范围插件保持原行为；matches支持通用*。",
      "windowSlots": [
        "titleAccessory",
        "topTrailing",
        "bottomBar"
      ]
    },
    {
      "id": "ctx.presentationID",
      "status": "stable",
      "apiVersions": [
        1,
        2
      ],
      "surface": "ctx.presentationID",
      "injected": true,
      "description": "一次叠层展示的宿主标识；可重置展开状态，不用于窗口身份。"
    },
    {
      "id": "ctx.activity",
      "status": "stable",
      "apiVersions": [
        2
      ],
      "surface": "ctx.activity",
      "injected": "when-authorized",
      "permission": "activity.read",
      "methods": [
        "summary",
        "sessions",
        "snapshots"
      ],
      "description": "异步有界本地查询；snapshots另需activity.snapshots，只有不透明图片引用，无像素/路径。",
      "limits": {
        "queryDays": 400,
        "sessionsPerPage": 100,
        "snapshotsPerPage": 6,
        "summaryRows": 1000,
        "responseBytes": 1048576,
        "callsPerInvocation": 8,
        "inFlight": 4
      },
      "snapshotSessionID": {
        "type": "optional UUID string",
        "meaning": "关联已有会话ID；不含路径，旧响应可缺省"
      },
      "errors": {
        "activityCursorExpired": "游标与当前查询、采集代次或已读前缀不一致；尾部追加不影响前缀时可继续，本批结束后可至多从第一页重载一次",
        "activityQueryFailed": "其他查询失败，不按游标过期自动重试",
        "activityInvalidated": "清除或撤权等使读取代次失效，不自动恢复",
        "activityUnavailable": "当前调用无权限、已停止或超出调用预算"
      }
    },
    {
      "id": "manifest.surfaces",
      "status": "stable",
      "apiVersions": [
        2
      ],
      "values": [
        "dockPreview",
        "panel"
      ],
      "default": [
        "dockPreview"
      ],
      "description": "可选独立panel；ctx.surface、panel槽位；panel中ctx.app/window为null；隐藏复用可见性租约。"
    },
    {
      "id": "ui.activity-panel-controls",
      "status": "stable",
      "apiVersions": [
        2
      ],
      "nodes": [
        "segmented",
        "dateRange",
        "barChart",
        "lineChart",
        "grid",
        "timeline"
      ],
      "description": "仅panel，有界声明式节点，日期分别发id.from/id.to数字epoch动作；活动图片宿主解析，不用于scene3d。"
    },
    {
      "id": "ui.lineChart",
      "status": "stable",
      "apiVersions": [
        2
      ],
      "surface": "panel",
      "requires": {
        "context": "ctx.uiFeatures.lineChart === true",
        "fallbackWhen": "ctx.uiFeatures?.lineChart !== true",
        "seriesContext": "ctx.uiFeatures.lineChartSeries === true"
      },
      "node": {
        "type": "lineChart",
        "items": "readonly {label:string,value:number}[]",
        "label": "optional string: total legend",
        "series": "optional readonly {label:string,items:readonly {label:string,value:number}[]}[]"
      },
      "itemType": "PluginBarItem",
      "limits": {
        "maxItems": 64,
        "labelMaxBytes": 200,
        "labelEncoding": "UTF-8",
        "value": "finite nonnegative number",
        "maxAdditionalSeries": 6,
        "seriesAlignment": "same item count and labels as items"
      },
      "placement": {
        "allowedSurfaces": [
          "panel"
        ],
        "forbiddenSurfaces": [
          "dockPreview",
          "scene3d.surface"
        ],
        "scene3dFallback": "allowed only in a panel 2d fallback; forbidden in Dock"
      },
      "description": "通用有界折线节点，复用barChart的label/value校验；仅panel槽位，不能用于scene3d纹理。panel的普通2D fallback可用，Dock fallback递归拒绝。整棵树仍遵守64节点和深度8预算。"
    },
    {
      "id": "ui.timeline",
      "status": "stable",
      "apiVersions": [
        2
      ],
      "surface": "panel",
      "requires": {
        "context": "ctx.uiFeatures.timeline === true",
        "fallbackWhen": "ctx.uiFeatures?.timeline !== true"
      },
      "node": {
        "type": "timeline",
        "items": "readonly {timestamp:number,content:PluginNode}[]"
      },
      "limits": {
        "maxItems": 12,
        "timestamp": "finite nonnegative epoch seconds",
        "maxNodes": 64,
        "maxDepth": 8
      },
      "placement": {
        "allowedSurfaces": [
          "panel"
        ],
        "forbiddenSurfaces": [
          "dockPreview",
          "scene3d.surface"
        ],
        "scene3dFallback": "allowed only in a panel 2d fallback; forbidden in Dock"
      },
      "description": "通用纵向时间线，宿主绘制本地日期、秒级时间、轴线和节点，按items顺序展示content；内容递归计入整树预算，旧宿主回退同顺序纵向列表。"
    }
  ],
  "permissions": [
    {
      "id": "media.nowPlaying",
      "status": "stable",
      "injectedWhenGranted": true
    },
    {
