{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://switchly.app/schemas/plugin-manifest-v1.json",
  "title": "Switchly 插件 manifest",
  "description": "与当前宿主 PluginManifest 解码和 validate() 对齐的 JSON Schema。宿主会忽略未声明字段。",
  "$comment": "包级硬限制由安装器执行：32 MiB、1024 entries、manifest 256 KiB、entry 2 MiB，且禁止 symlink。",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "apiVersion",
    "matches",
    "permissions",
    "entry"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(\\.[A-Za-z0-9-]+)+$",
      "description": "反向域名风格且全局唯一的插件 ID。"
    },
    "name": {
      "$ref": "#/$defs/localizedText",
      "description": "按语言标识本地化的显示名。"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "插件自身的非空版本字符串；不强制 SemVer，以兼容历史 version=\"1\"。"
    },
    "apiVersion": {
      "type": "integer",
      "enum": [
        1,
        2
      ],
      "description": "1 为旧宿主合同；2 允许 v2 协商增量。apiVersion 2 本身不代表宿主可渲染 3D：scene3d 只能在此后由 ctx.uiFeatures.scene3d === true 确认，且 scene3d 节点不写入 manifest。"
    },
    "summary": {
      "$ref": "#/$defs/localizedText"
    },
    "matches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "目标应用的 bundle ID。"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "enum": [
              "media.nowPlaying",
              "media.control",
              "media.library",
              "weather.current",
              "window.focus",
              "fs.read"
            ]
          },
          {
            "type": "string",
            "pattern": "^appleScript:.+$"
          }
        ]
      },
      "description": "未知权限会令宿主 manifest 解码失败。"
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        ]
      },
      "description": "相对插件目录的 JavaScript 入口，不得为绝对路径或包含 .. 路径段。"
    },
    "refreshInterval": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 86400,
      "description": "可见期间的重绘间隔秒数；宿主会将其下限钳制为 1 秒。"
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/setting"
      }
    },
    "fsRoots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fsRoot"
      }
    },
    "defaultEnabled": {
      "type": "boolean",
      "description": "仅对内置插件生效；缺省视为 true。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "permissions": {
            "contains": {
              "const": "fs.read"
            }
          }
        },
        "required": [
          "permissions"
        ]
      },
      "then": {
        "required": [
          "fsRoots"
        ],
        "properties": {
          "fsRoots": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "fsRoots": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "settingOption": {
      "type": "object",
      "required": [
        "value",
        "title"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        }
      }
    },
    "setting": {
      "type": "object",
      "required": [
        "key",
        "title",
        "default"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "type": {
          "enum": [
            "toggle",
            "select",
            "number"
          ],
          "default": "toggle"
        },
        "default": {
          "type": [
            "boolean",
            "string",
            "number"
          ]
        },
        "effect": {
          "enum": [
            "hideWindowPreviews"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/settingOption"
          }
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "not": {
                  "required": [
                    "type"
                  ]
                }
              },
              {
                "properties": {
                  "type": {
                    "const": "toggle"
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "default": {
                "type": "string"
              },
              "options": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "fsRoot": {
      "type": "object",
      "required": [
        "id",
        "path",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:/|~/)",
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "description": "绝对路径或以 ~/ 开头的用户目录路径；运行时还会拒绝密钥、浏览器资料等敏感位置。"
        },
        "summary": {
          "$ref": "#/$defs/localizedText"
        }
      }
    }
  }
}
