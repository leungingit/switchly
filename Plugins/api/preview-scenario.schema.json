{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://switchly.local/plugin-api/preview-scenario.schema.json",
  "title": "Switchly 插件预览场景（开发中）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "environment", "target"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "surface": { "enum": ["dockPreview", "panel"] },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["locale", "appearance", "glass", "reduceMotion", "contentWidthPoints"],
      "properties": {
        "locale": { "enum": ["en", "zh-Hans"] },
        "appearance": { "enum": ["light", "dark"] },
        "glass": { "type": "boolean" },
        "reduceMotion": { "type": "boolean" },
        "contentWidthPoints": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["bundleID", "appName"],
      "properties": {
        "bundleID": { "type": "string", "minLength": 1 },
        "appName": { "type": "string", "minLength": 1 },
        "titleSummary": { "type": "string" },
        "lastActiveAt": { "type": ["number", "null"] }
      }
    },
    "fixtures": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "media": { "$ref": "#/$defs/relativePath" },
        "weather": { "$ref": "#/$defs/relativePath" },
        "fs": { "$ref": "#/$defs/relativePath" },
        "activity": { "$ref": "#/$defs/relativePath" }
      }
    },
    "clock": {
      "type": "object", "additionalProperties": false,
      "required": ["startEpochMs", "seed"],
      "properties": {
        "startEpochMs": { "type": "number", "minimum": 0 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "grants": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "settings": { "type": "object", "additionalProperties": { "type": ["boolean", "number", "string"] } },
    "storageSeed": { "type": "object" },
    "steps": {
      "type": "array", "maxItems": 64,
      "items": {
        "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["type", "ms"],
            "properties": { "type": { "const": "advance" }, "ms": { "type": "number", "minimum": 0, "maximum": 86400000 } } },
          { "type": "object", "additionalProperties": false, "required": ["type", "id"],
            "properties": { "type": { "const": "action" }, "id": { "type": "string", "minLength": 1, "maxLength": 128 }, "value": { "type": "number" } } },
          { "type": "object", "additionalProperties": false, "required": ["type", "contains"],
            "properties": { "type": { "const": "expectText" }, "contains": { "type": "string", "minLength": 1, "maxLength": 256 } } },
          { "type": "object", "additionalProperties": false, "required": ["type", "label"],
            "properties": { "type": { "const": "nativeClick" }, "label": { "type": "string", "minLength": 1, "maxLength": 256 },
                            "expectAction": { "type": "string", "minLength": 1, "maxLength": 128 }, "expectDisabled": { "type": "boolean" } } },
          { "type": "object", "additionalProperties": false, "required": ["type", "point"],
            "properties": { "type": { "const": "nativeClickAt" }, "point": { "$ref": "#/$defs/point" },
                            "expectAction": { "type": "string", "minLength": 1, "maxLength": 128 } } },
          { "type": "object", "additionalProperties": false, "required": ["type", "from", "to"],
            "properties": { "type": { "const": "nativeDrag" }, "from": { "$ref": "#/$defs/point" }, "to": { "$ref": "#/$defs/point" } } }
        ]
      },
      "description": "advance 需要 clock；action 是业务直调；nativeClick 经 AX press，expectDisabled 与 expectAction 互斥。nativeClickAt/nativeDrag 使用截图表面左上角逻辑点，仅适配真实 SceneKit 视图，不投递全局键鼠。"
    }
  },
  "$defs": {
    "point": { "type": "object", "additionalProperties": false, "required": ["x", "y"],
               "properties": { "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 } } },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000]*[^/\\u0000]$" }
  }
}
